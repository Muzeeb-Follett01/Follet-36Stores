    '    await productPage.searchAndSelectProduct(PRODUCT_1.name, PRODUCT_1.link, testInfo);\n' +
    '    console.log(`🖱️  Step 3: Selecting format: ${PRODUCT_1.format} with condition ${PRODUCT_1.condition}`);\n' +
    '    await productPage.selectFormat(PRODUCT_1.format, PRODUCT_1.condition, testInfo);\n' +
    '    console.log(`🛒 Step 4: Adding to cart – ${PRODUCT_1.name}`);\n' +
    '    await productPage.addToCart(testInfo);\n' +
    '\n' +
    '    // ── Steps 5-7: Product 2 – Digital Literacies (Digital / Buy) ────────────\n' +
    '    console.log(`📱 Step 5: Searching for "${PRODUCT_2.name}"`);\n' +
    '    await productPage.searchAndSelectProduct(PRODUCT_2.name, PRODUCT_2.link, testInfo);\n' +
    '    console.log(`🖱️  Step 6: Selecting format: ${PRODUCT_2.format} with condition ${PRODUCT_2.condition}`);\n' +
    '    await productPage.selectFormat(PRODUCT_2.format, PRODUCT_2.condition, testInfo);\n' +
    '    console.log(`🛒 Step 7: Adding to cart – ${PRODUCT_2.name}`);\n' +
    '    await productPage.addToCart(testInfo);\n' +
    '\n' +
    '    // ── Step 8: Proceed to checkout ────────────────────────────────────────────\n' +
    '    console.log("💳 Step 8: Clicking Check out");\n' +
    '    await productPage.clickCheckout(testInfo);\n' +
    '\n' +
    '    // ── Step 9: Fill contact email ─────────────────────────────────────────────\n' +
    '    console.log(`📧 Step 9: Filling email – ${CUSTOMER_EMAIL}`);\n' +
    '    await checkoutPage.fillEmail(CUSTOMER_EMAIL);\n' +
