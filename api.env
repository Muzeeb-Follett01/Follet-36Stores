# ============================================================================
# COMMON SETTINGS
# ============================================================================

# Logging Configuration
LOG_REQUESTS=true
LOG_RESPONSES=false
LOG_LEVEL=info

# Response Handling
SAVE_RESPONSES=false
RESPONSE_DIR=./test-results/api-responses
VALIDATE_RESPONSE=true

# Performance Settings
DEFAULT_TIMEOUT=30000
MAX_CONCURRENT_REQUESTS=10
RETRY_DELAY=1000

# Test Data Settings
TEST_DATA_DIR=./testdata/api
FAKER_LOCALE=en

# Report Settings
GENERATE_REPORTS=true
REPORT_DIR=./test-results/api-reports
REPORT_FORMAT=json

# ============================================================================
# REQRES API ENDPOINTS (for testing)
# ============================================================================
REQRES_USERS=/users
REQRES_LOGIN=/login
REQRES_REGISTER=/register

# ============================================================================
# JSONPLACEHOLDER ENDPOINTS (for testing)
# ============================================================================
JSONPLACEHOLDER_POSTS=/posts
JSONPLACEHOLDER_USERS=/users
JSONPLACEHOLDER_COMMENTS=/comments
JSONPLACEHOLDER_ALBUMS=/albums
JSONPLACEHOLDER_PHOTOS=/photos
JSONPLACEHOLDER_TODOS=/todos

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# API Keys (Use environment-specific values)
API_KEY_HEADER=X-API-Key
API_KEY_VALUE=

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# SSL Settings
SSL_VERIFY=true

# ============================================================================
# NETWORK SETTINGS
# ============================================================================

# User Agent
USER_AGENT=Playwright-API-Testing/1.0

# Headers
ACCEPT_HEADER=application/json
CONTENT_TYPE_HEADER=application/json

# ============================================================================
# GMAIL API CONFIGURATION
# ============================================================================

# Gmail OAuth 2.0 Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com/)
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/callback

# Gmail Refresh Token (obtained after OAuth flow)
# Set this after completing the OAuth authorization
GMAIL_REFRESH_TOKEN=

# Optional: Service account credentials file path (alternative to OAuth)
GMAIL_CREDENTIALS_PATH=

# Optional: Token storage path
GMAIL_TOKEN_PATH=./gmail-token.json

# ============================================================================
# MONITORING & DEBUGGING
# ============================================================================

# Performance Monitoring
MONITOR_PERFORMANCE=true
PERFORMANCE_THRESHOLD=3000

# Debug Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ============================================================================
# MAILOSAUR CONFIGURATION
# ============================================================================
MAILOSAUR_API_KEY=In5Qy9PuY6j3zJ01AAcIpgkGusdRWlW7
MAILOSAUR_SERVER_ID=gzncezet