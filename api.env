# API Testing Environment Configuration
# Copy this to api.env and customize for your environment

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================

# Current environment (development, testing, staging, production)
API_ENVIRONMENT=testing

# ============================================================================
# DEVELOPMENT ENVIRONMENT
# ============================================================================
DEV_BASE_URL=http://localhost:3000/api
DEV_TIMEOUT=30000
DEV_RETRIES=3

# Development Authentication
DEV_AUTH_TYPE=bearer
DEV_AUTH_TOKEN=
DEV_AUTH_USERNAME=
DEV_AUTH_PASSWORD=

# ============================================================================
# TESTING ENVIRONMENT  
# ============================================================================
TESTING_BASE_URL=https://qas-api-loanpayoff.iaai.com
TESTING_TIMEOUT=30000
TESTING_RETRIES=3

# Testing Authentication
TESTING_AUTH_TYPE=bearer
TESTING_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3NjkyNjg2MDYsImlzcyI6IkxvYW5QYXlvZmYuQXBpIiwiYXVkIjoicWFzLWFwaS1sb2FucGF5b2ZmLmlhYWkuY29tIn0.gal1PmgJlJViobO0yaFwuWFV1yNWnu6mv9QnpJXU4e0
TESTING_AUTH_USERNAME=
TESTING_AUTH_PASSWORD=

# ============================================================================
# STAGING ENVIRONMENT
# ============================================================================
STAGING_BASE_URL=https://staging-api.example.com/api
STAGING_TIMEOUT=45000
STAGING_RETRIES=5

# Staging Authentication
STAGING_AUTH_TYPE=bearer
STAGING_AUTH_TOKEN=
STAGING_AUTH_USERNAME=
STAGING_AUTH_PASSWORD=

# ============================================================================
# PRODUCTION ENVIRONMENT
# ============================================================================
PROD_BASE_URL=https://api.example.com
PROD_TIMEOUT=60000
PROD_RETRIES=5

# Production Authentication (Use secure methods to store these)
PROD_AUTH_TYPE=bearer
PROD_AUTH_TOKEN=
PROD_AUTH_USERNAME=
PROD_AUTH_PASSWORD=

