{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "description": "Playwright Accelerator",
  "main": "",
  "scripts": {
    "sample-test": "node ./scripts/cleanup-browserstack-lock.js && npx browserstack-node-sdk playwright test --config=./playwright.config.ts",
    "sample-test:mobile": "set MOBILE=true&&node ./scripts/cleanup-browserstack-lock.js&&npx browserstack-node-sdk playwright test --config=./playwright.config.ts",
    "test:mobile": "set MOBILE=true&&npx playwright test",
    "generatebdd": "playwright-bdd-generator ./bddgenerator",
    "bddtest": "npx bddgen && npx playwright test",
    "test": "npx playwright test",
    "open:uimode": "npx playwright test --ui",
    "open:report": "npx playwright show-report",
    "notify:teams": "npx test-results-reporter publish -c notify-results/config.json"
  },
  "keywords": [
    "playwright",
    "typescript"
  ],
  "author": "Mohammed Akbar Ali",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/convert-excel-to-json": "^1.7.4",
    "@types/node": "^20.11.6",
    "browserstack-node-sdk": "^1.49.12",
    "dotenv": "^17.3.1",
    "msw": "^1.3.2",
    "playwright-bdd": "^8.4.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/mcp": "^0.0.32",
    "@types/oracledb": "^6.10.0",
    "ajv": "^8.17.1",
    "convert-excel-to-json": "^1.7.0",
    "exceljs": "^4.4.0",
    "init": "^0.1.2",
    "jsonpath": "^1.1.1",
    "mailosaur": "^9.0.0",
    "mssql": "^12.2.0",
    "oracledb": "^6.10.0",
    "playwright": "^1.56.1",
    "test-results-reporter": "^1.0.19",
    "xlsx": "^0.18.5"
  }
}
