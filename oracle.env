# Oracle Database Configuration
# This file contains Oracle database connection settings for different environments
# Copy oracle.env.template to oracle.env and fill in your actual credentials

# IMPORTANT: Add oracle.env to your .gitignore file to protect sensitive credentials

# ==============================================
# TESTING ENVIRONMENT (Default for tests)
# ==============================================
TEST_ORACLE_USER=test_user
TEST_ORACLE_PASSWORD=test_password
TEST_ORACLE_CONNECT_STRING=localhost:1521/xepdb1

# Pool settings for testing
TEST_ORACLE_POOL_MIN=2
TEST_ORACLE_POOL_MAX=8
TEST_ORACLE_POOL_INCREMENT=1
TEST_ORACLE_POOL_TIMEOUT=45
TEST_ORACLE_STMT_CACHE_SIZE=25

# ==============================================
# DEVELOPMENT ENVIRONMENT
# ==============================================
DEV_ORACLE_USER=dev_user
DEV_ORACLE_PASSWORD=dev_password
DEV_ORACLE_CONNECT_STRING=localhost:1521/xepdb1

# Pool settings for development
DEV_ORACLE_POOL_MIN=1
DEV_ORACLE_POOL_MAX=5
DEV_ORACLE_POOL_INCREMENT=1
DEV_ORACLE_POOL_TIMEOUT=30
DEV_ORACLE_STMT_CACHE_SIZE=20

# ==============================================
# DEFAULT/FALLBACK SETTINGS
# ==============================================
# Used when no environment-specific prefix matches
ORACLE_USER=default_user
ORACLE_PASSWORD=default_password
ORACLE_CONNECT_STRING=localhost:1521/xepdb1

# Default pool settings
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_STMT_CACHE_SIZE=30

# ==============================================
# ADDITIONAL SETTINGS
# ==============================================
# Enable debug logging
ORACLE_DEBUG=false

# Connection and query timeouts
ORACLE_CONNECTION_TIMEOUT=60
ORACLE_QUERY_TIMEOUT=30

# ==============================================
# NOTES
# ==============================================
# 1. Replace placeholder values with your actual database credentials
# 2. Environment-specific settings (TEST_, DEV_, PROD_) take priority over defaults
# 3. This file will be automatically loaded by the Oracle testing utility
# 4. You can override any setting with system environment variables
# 5. Add this file to .gitignore to keep credentials secure